# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by Git. Never commit real credentials.

SLOTFORGE_DB_URL=jdbc:postgresql://localhost:5432/slotforge
SLOTFORGE_DB_USERNAME=slotforge
SLOTFORGE_DB_PASSWORD=change-me

# Only needed with the google profile.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
SLOTFORGE_GOOGLE_ALLOWED_DOMAINS=
